<h3>新規追加</h3>

<%= form_with model: @schedule, local: true do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :start_date, "開始日" %><br>
    <%= f.datetime_select :start_date %>
  </div>

  <div>
    <%= f.label :end_date, "終了日" %><br>
    <%= f.datetime_select :end_date %>
  </div>

  <div>
    <%= f.label :all_day, "終日" %>
    <%= f.check_box :all_day %>
  </div>

  <div>
    <%= f.label :memo, "スケジュールメモ" %><br>
    <%= f.text_area :memo %>
  </div>

  <div>
    <%= f.submit "登録" %>
  </div>

<% end %>

<div>
  <%= link_to "一覧へ戻る", schedules_path %>
</div>