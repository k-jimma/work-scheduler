<h3>スケジュール詳細</h3>

<table>
  <tr>
    <th>タイトル</th>
    <td><%= @schedule.title %></td>
  </tr>
  <tr>
    <th>開始日</th>
    <td><%= @schedule.start_date.to_fs(:date_jp) %></td>
  </tr>
  <tr>
    <th>終了日</th>
    <td><%= @schedule.end_date.to_fs(:date_jp) %></td>
  </tr>
  <tr>
    <th>終日</th>
    <td><%= @schedule.all_day ? "◯" : "" %></td>
  </tr>
  <tr>
    <th>スケジュールメモ</th>
    <td><%= simple_format(@schedule.memo) %></td>
  </tr>
</table>

<div>
  <%= link_to "一覧へ戻る", schedules_path %>
</div>
<div>
  <%= link_to "編集", edit_schedule_path(@schedule) %>
</div>
