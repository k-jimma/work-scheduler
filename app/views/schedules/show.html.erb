<div class="container py-4">
  <h3 class="mb-3">スケジュール詳細</h3>

  <div class="card">
    <div class="card-body">
      <table class="table mb-0">
        <tr>
          <th class="w-25">タイトル</th>
          <td><%= @schedule.title %></td>
        </tr>
        <tr>
          <th>開始日</th>
          <td><%= @schedule.start_date.to_fs(:date_jp) %></td>
        </tr>
        <tr>
          <th>終了日</th>
          <td><%= @schedule.end_date.to_fs(:date_jp) %></td>
        </tr>
        <tr>
          <th>終日</th>
          <td><%= @schedule.all_day ? "◯" : "" %></td>
        </tr>
        <tr>
          <th>スケジュールメモ</th>
          <td><%= simple_format(@schedule.memo) %></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="mt-3 d-flex gap-2">
    <%= link_to "一覧へ戻る", schedules_path, class: "btn btn-outline-secondary" %>
    <%= link_to "編集", edit_schedule_path(@schedule), class: "btn btn-primary" %>
  </div>
</div>
