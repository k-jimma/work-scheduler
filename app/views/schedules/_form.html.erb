<% if schedule.errors.any? %>
  <div class="alert alert-danger">
    入力内容を確認してください
  </div>
<% end %>

<%= form_with model: schedule, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :title, "タイトル", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", maxlength: 20 %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_date, "開始日", class: "form-label" %>
      <%= f.date_field :start_date, class: "form-control", required: true %>
    </div>

    <div class="col-md-6 mb-3">
      <%= f.label :end_date, "終了日", class: "form-label" %>
      <%= f.date_field :end_date, class: "form-control", required: true %>
    </div>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :all_day, class: "form-check-input" %>
    <%= f.label :all_day, "終日", class: "form-check-label" %>
  </div>

  <div class="mb-3">
    <%= f.label :memo, "スケジュールメモ", class: "form-label" %>
    <%= f.text_area :memo, class: "form-control", rows: 5, maxlength: 500 %>
    <div class="form-text">最大500文字</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "キャンセル", schedules_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

