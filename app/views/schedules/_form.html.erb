<% if schedule.errors.any? %>
  <div>
    <p>入力内容を確認してください</p>
  </div>
<% end %>

<%= form_with model: schedule, local: true do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :start_date, "開始日" %><br>
    <%= f.date_select :start_date %>
  </div>

  <div>
    <%= f.label :end_date, "終了日" %><br>
    <%= f.date_select :end_date %>
  </div>

  <div>
    <%= f.label :all_day, "終日" %>
    <%= f.check_box :all_day %>
  </div>

  <div>
    <%= f.label :memo, "スケジュールメモ" %><br>
    <%= f.text_area :memo %>
  </div>

  <div>
    <%= f.submit submit_label %>
  </div>
<% end %>
