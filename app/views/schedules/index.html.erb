<h3>予定一覧</h3>

<p>本日：<%= Date.current.to_fs(:date_jp) %></p>

<%= link_to "新規作成", new_schedule_path %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th>詳細</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>
  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= schedule.start_date.to_fs(:date_jp) %></td>
        <td><%= schedule.end_date.to_fs(:date_jp) %></td>
        <td><%= schedule.all_day ? "◯" : "" %></td>
        <td><%= schedule.updated_at.to_fs(:datetime_jp) %></td>
        <td><%= link_to "詳細", schedule_path(schedule) %></td>
        <td><%= link_to "編集", edit_schedule_path(schedule) %></td>
        <td><%= link_to "削除", schedules_path(schedule), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>予定の合計: <%= @schedules.count %> 件</p>
