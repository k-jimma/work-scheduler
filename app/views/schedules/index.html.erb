<div class="container py-4">
  <h3 class="mb-3">スケジュール一覧</h3>

  <p class="text-muted">
    本日：<%= Date.current.to_fs(:date_jp) %>
  </p>

<div class="mb-3">
  <%= link_to "新規作成", new_schedule_path, class: "btn btn-primary" %>
</div>

  <table class="table table-striped table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>タイトル</th>
        <th>開始日</th>
        <th>終了日</th>
        <th>終日</th>
        <th>更新日時</th>
        <th class="text-center">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @schedules.each do |schedule| %>
        <tr>
          <td><%= schedule.id %></td>
          <td><%= schedule.title %></td>
          <td><%= schedule.start_date.to_fs(:date_jp) %></td>
          <td><%= schedule.end_date.to_fs(:date_jp) %></td>
          <td><%= schedule.all_day ? "◯" : "" %></td>
          <td><%= schedule.updated_at.to_fs(:datetime_jp) %></td>
          <td class="text-center">
            <div>
              <%= link_to "詳細", schedule_path(schedule), class: "btn btn-outline-primary" %>
              <%= link_to "編集", edit_schedule_path(schedule), class: "btn btn-outline-secondary" %>
              <%= link_to "削除",
                schedule_path(schedule),
                data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                class: "btn btn-outline-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p>予定の合計: <%= @schedules.count %> 件</p>
</div>
